UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
TZ=Asia/Shanghai
IMMICH_VERSION=v3.3.0
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
CPU_CORES=2
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_REQUEST_THREADS=2
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=1
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=1
MACHINE_LEARNING_MODEL_TTL=300
MACHINE_LEARNING_WORKER_TIMEOUT=300
LOG_LEVEL=log
IMMICH_CONFIG_FILE=/config/immich-config.json
IMMICH_UPLOAD_CONCURRENCY=5
